<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="QA Practice Suite" verbose="1">

    <listeners>
        <listener class-name="com.aventstack.chaintest.plugins.ChainTestListener"/>
    </listeners>

    <test name="QA Practice Tests">
        <classes>

            <!-- Teste initiale -->
            <class name="Tests.LoginTest"/>
            <class name="Tests.LoginWrongPasswordTest"/>
            <class name="Tests.RegistrationFormTest"/>
            <class name="Tests.EcommerceTest"/>
            <class name="Tests.UIElementsTest"/>

            <!-- Teste refactorizate -->
            <class name="Tests_Refactorizat.LoginTest"/>
            <class name="Tests_Refactorizat.EcommerceTest"/>
            <class name="Tests_Refactorizat.UIElementsTest"/>
            <class name="Tests_Refactorizat.LoggerTest"/>
            <class name="Tests_Refactorizat.XML_TESTS.XmlDataLoaderTest"/>

            <!-- Test API -->
            <class name="Tests_Refactorizat.ApiTest"/>

        </classes>
    </test>

</suite>
